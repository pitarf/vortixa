# Configurações do Banco de Dados PostgreSQL (Docker local)
DATABASE_URL="postgresql://vorixa_user:vorixa_password@localhost:5432/vorixa_db?schema=public&connection_limit=10"

# Criptografia de Sessão / JWT
AUTH_SECRET="substitua-por-um-secret-gerado-com-openssl-rand-hex-32"

# URL da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# API da fal.ai
FAL_KEY="sua-chave-api-da-fal-ai"

# Provedor de Pagamentos Ativo: "mercadopago" | "stripe" | "mock_gateway"
PAYMENT_PROVIDER="mock_gateway"
PAYMENT_PROVIDER_MODE="test" # "test" | "live"

# Gateway Mercado Pago (Pix e Cartão)
MERCADOPAGO_ACCESS_KEY="APP_USR-seu-access-token-do-mercadopago"
MERCADOPAGO_PUBLIC_KEY="APP_USR-sua-public-key-do-mercadopago"
MERCADOPAGO_WEBHOOK_SECRET="seu-secret-de-webhook-do-mercadopago"
MERCADOPAGO_SANDBOX="true"

# Gateway Stripe (Cartão Global e Métodos Internacionais)
STRIPE_SECRET_KEY="sk_test_seu-secret-key-do-stripe"
STRIPE_PUBLIC_KEY="pk_test_sua-public-key-do-stripe"
STRIPE_WEBHOOK_SECRET="whsec_seu-webhook-secret-do-stripe"

# Configurações de E-mail Transacional Direto (SMTP / Hostinger)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="seu-email@dominio.com.br"
SMTP_PASS="sua-senha-smtp"
SMTP_FROM="seu-email@dominio.com.br"
SMTP_SENDER_NAME="VORIXA AI"

# Gateway Legado / Mock VorexPay
VOREXPAY_API_KEY="sua-chave-api-do-vorexpay"
VOREXPAY_WEBHOOK_SECRET="seu-secret-de-webhook-do-vorexpay"

# Configurações do Storage (MinIO local / Cloudflare R2 em produção)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minio_admin"
STORAGE_SECRET_KEY="minio_password"
STORAGE_BUCKET="vorixa-files"
